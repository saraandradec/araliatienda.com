{
  "name": "aralia/ecommerce",
  "description": "Aralía Beauty Store — WooCommerce (tier TRACE T0). Solo código propio; WordPress y plugins de terceros se instalan en Hostinger (composer los usa únicamente para pruebas y wp-env).",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "composer/installers": "2.3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "1.0.0",
    "php-stubs/woocommerce-stubs": "v11.2.1",
    "phpcompatibility/phpcompatibility-wp": "2.1.6",
    "phpstan/phpstan": "1.12.7",
    "phpunit/phpunit": "9.6.39",
    "roots/wordpress-core-installer": "1.100.0",
    "roots/wordpress-no-content": "7.1.4",
    "szepeviktor/phpstan-wordpress": "1.3.5",
    "wp-coding-standards/wpcs": "3.4.1",
    "wpackagist-plugin/wompi-portal-de-pagos": "3.2.1",
    "wpackagist-plugin/woocommerce": "11.2.1",
    "wpackagist-plugin/wordfence": "9.0.2",
    "yoast/phpunit-polyfills": "2.0.2"
  },
  "autoload": {
    "psr-4": {
      "Aralia\\": "wp-content/plugins/aralia-core/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aralia\\Tests\\": "tests/php/"
    }
  },
  "extra": {
    "wordpress-install-dir": "wp",
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.0"
    },
    "audit": {
      "abandoned": "fail"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "stan": "phpstan analyse --memory-limit=1G",
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:contract": "phpunit --testsuite contract"
  }
}
