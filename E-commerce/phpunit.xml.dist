<?xml version="1.0" encoding="UTF-8"?>
<!--
  unit: sin WordPress (CI, job php).
  integration y contract: dentro de wp-env (tests-cli), con WordPress, WooCommerce y el plugin de Wompi.
  Una suite vacía falla: la prueba de contrato no puede "pasar" sin pruebas.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         cacheResultFile=".phpunit.cache/test-results">
    <php>
        <!-- error_log() del mu-plugin no debe ensuciar la salida de los procesos aislados. -->
        <ini name="error_log" value="/dev/null"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/php/unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">tests/php/integration</directory>
        </testsuite>
        <testsuite name="contract">
            <directory suffix="Test.php">tests/php/contract</directory>
        </testsuite>
    </testsuites>
</phpunit>
